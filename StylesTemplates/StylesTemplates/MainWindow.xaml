<Window x:Class="StylesTemplates.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StylesTemplates"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid Background="#F4F6FA">
            <Border Background="White" BorderBrush="#D0D7E2" BorderThickness="1"
                CornerRadius="8" Margin="20" Padding="20">
                <StackPanel>

                    <TextBlock FontSize="24" FontWeight="Bold"
                           Foreground="#2D6CDF" Margin="0,0,0,4">Fiche client</TextBlock>
                    <TextBlock FontSize="12" Foreground="#6B7280" Margin="0,0,0,16">Veuillez remplir les informations du client.</TextBlock>

                    <TextBlock FontSize="13" FontWeight="SemiBold"
                           Foreground="#374151" Margin="0,0,0,4">Prénom</TextBlock>
                    <TextBox FontSize="14" Padding="6,4" Margin="0,0,0,12"
                         BorderBrush="#D0D7E2" BorderThickness="1"/>

                    <TextBlock FontSize="13" FontWeight="SemiBold"
                           Foreground="#374151" Margin="0,0,0,4">Nom</TextBlock>
                    <TextBox FontSize="14" Padding="6,4" Margin="0,0,0,12"
                         BorderBrush="#D0D7E2" BorderThickness="1"/>

                    <TextBlock FontSize="13" FontWeight="SemiBold"
                           Foreground="#374151" Margin="0,0,0,4">Courriel</TextBlock>
                    <!-- Padding -->
                    <TextBox FontSize="14" Padding="4" Margin="0,0,0,12"
                         BorderBrush="#D0D7E2" BorderThickness="1"/>

                    <!-- FontWeight -->
                    <TextBlock FontSize="13"
                           Foreground="#374151" Margin="0,0,0,4">Téléphone</TextBlock>
                    <TextBox FontSize="14" Padding="6,4" Margin="0,0,0,12"
                         BorderBrush="#D0D7E2" BorderThickness="1"/>

                    <CheckBox FontSize="13" Foreground="#374151" Margin="0,4,0,20">Recevoir l'infolettre</CheckBox>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button FontSize="14" Padding="14,6" Margin="0,0,8,0"
                            MinWidth="90" Background="#DC2626" Foreground="White"
                            BorderThickness="0" Cursor="Hand">Supprimer</Button>
                        <Button FontSize="14" Padding="14,6" Margin="0,0,8,0"
                            MinWidth="90" Background="White" Foreground="#374151"
                            BorderBrush="#D0D7E2" BorderThickness="1" Cursor="Hand">Annuler</Button>
                        <!-- bleu légèrement différent du titre (#2D6CDE vs #2D6CDF) -->
                        <Button FontSize="14" Padding="14,6"
                            MinWidth="90" Background="#2D6CDE" Foreground="White"
                            BorderThickness="0" Cursor="Hand">Enregistrer</Button>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
