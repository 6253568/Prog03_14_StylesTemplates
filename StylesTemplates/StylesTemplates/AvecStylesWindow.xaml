<Window x:Class="StylesTemplates.AvecStylesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StylesTemplates"
        mc:Ignorable="d"
   Title="AvecStylesWindow" Height="520" Width="460" WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- Couleurs: définies 1 seule fois -->
        <SolidColorBrush x:Key="CouleurPrimaire" Color="#2D6CDF"/>
        <SolidColorBrush x:Key="CouleurDanger" Color="#DC2626"/>
        <SolidColorBrush x:Key="CouleurTexte" Color="#374151"/>
        <SolidColorBrush x:Key="CouleurDiscrete" Color="#6B7280"/>
        <SolidColorBrush x:Key="CouleurBordure" Color="#D0D7E2"/>
        <SolidColorBrush x:Key="CouleurFond" Color="#F4F6FA"/>

        <!--On nomme le style avec "x:Key" -->
        <!-- Pour l'utiliser:  Style="{StaticResource NomStyle}" -->
        <!-- TargetType: pour dire le style s'applique à quel contrôle (aux TextBlock dans ce cas) -->
        <Style x:Key="TitreStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Foreground" Value="{StaticResource CouleurPrimaire}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="SousTitreStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource CouleurDiscrete}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>


        <Style x:Key="EtiquetteStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource CouleurTexte}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="CarteStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource CouleurBordure}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="20"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <!-- Si on ne met pas le x:Key, le style s'applique à tous les "TargetType" de la fenêtre -->
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="BorderBrush" Value="{StaticResource CouleurBordure}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource CouleurTexte}"/>
            <Setter Property="Margin" Value="0,4,0,20"/>
        </Style>

        <Style x:Key="BoutonPrimaire" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource CouleurPrimaire}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="BoutonSecondaire" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource CouleurTexte}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CouleurBordure}"/>
        </Style>

        <Style x:Key="BoutonDanger" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource CouleurDanger}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>
    <!-- Après les styles (Window.Resources), c'est le XAML habituel (la structure du UI) -->
    <Grid Background="{StaticResource CouleurFond}">
        <Border Style="{StaticResource CarteStyle}">
            <StackPanel>

                <TextBlock Style="{StaticResource TitreStyle}">Fiche client</TextBlock>
                <TextBlock Style="{StaticResource SousTitreStyle}">Veuillez remplir les informations du client.</TextBlock>

                <TextBlock Style="{StaticResource EtiquetteStyle}">Prénom</TextBlock>
                <TextBox/>

                <TextBlock Style="{StaticResource EtiquetteStyle}">Nom</TextBlock>
                <TextBox/>

                <TextBlock Style="{StaticResource EtiquetteStyle}">Courriel</TextBlock>
                <TextBox/>

                <TextBlock Style="{StaticResource EtiquetteStyle}">Téléphone</TextBlock>
                <TextBox/>

                <CheckBox>Recevoir l'infolettre</CheckBox>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Une valeur locale a priorité sur le Style : ici on retire/écrase la valeur du margin -->
                    <Button Style="{StaticResource BoutonDanger}" Margin="0">Supprimer</Button>
                    <Button Style="{StaticResource BoutonSecondaire}">Annuler</Button>
                    <Button Style="{StaticResource BoutonPrimaire}">Enregistrer</Button>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>
<!-- Si on veut que le style soit disponible à toutes les windows, il faut le mettre dans   -->